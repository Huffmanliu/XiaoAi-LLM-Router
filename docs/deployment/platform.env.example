PLATFORM_DEPLOYMENT=production
PLATFORM_PUBLIC_ORIGIN=https://speaker.example.com
PLATFORM_COOKIE_SECURE=1
# Only the local reverse proxy can supply the client IP and HTTPS scheme.
PLATFORM_TRUSTED_PROXIES=127.0.0.1,::1
PLATFORM_STATE_DIR=/var/lib/xiaoai-platform
PLATFORM_KEY_FILE=/etc/xiaoai-platform/platform.key
PLATFORM_MAIL_CONFIG=/etc/xiaoai-platform/mail.json
# Optional licensed local MaxMind city database. Without it IP changes require email.
# PLATFORM_CITY_DB=/var/lib/xiaoai-platform/GeoLite2-City.mmdb
# On production, exclude any speakers reserved for local development.
# PLATFORM_EXCLUDED_DEVICES=LOCAL_PLAY_DEVICE_ID
